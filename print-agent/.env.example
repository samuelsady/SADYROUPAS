# Endereço do sistema (produção)
SADY_URL=https://seu-sistema.vercel.app
# Mesmo valor de PRINT_AGENT_TOKEN configurado no servidor
PRINT_AGENT_TOKEN=
# Nome da impressora no Windows/CUPS (vazio = impressora padrão)
PRINTER_NAME=
# auto (windows no Windows, lp no Linux/macOS) | windows | lp | file | console
PRINT_MODE=auto
# Identificador deste computador (opcional)
AGENT_ID=
