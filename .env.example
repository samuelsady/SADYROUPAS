# =============================================================================
# Sady Roupas — variáveis de ambiente
# Copie para .env (desenvolvimento) ou configure no painel da Vercel (produção).
# NUNCA versione o arquivo .env. Nenhuma destas variáveis é exposta ao navegador.
# =============================================================================

# Banco PostgreSQL (Supabase: use a connection string "Session pooler" ou direta)
DATABASE_URL="postgresql://sady:sady@localhost:5432/sady?schema=public"

# Segredo da sessão do painel (mínimo 32 caracteres). Gere com: openssl rand -base64 48
AUTH_SECRET=""

# URL pública do sistema (usada no QR Code das peças e nos links)
APP_URL="http://localhost:3000"

# Modo prévia: com valor, o site inteiro pede essa senha (HTTP Basic) e não é indexado.
# Deixe vazio para abrir ao público.
PREVIEW_PASSWORD=""

# --- WhatsApp Business Platform (Cloud API oficial da Meta) ------------------
# Enquanto vazio, mantenha o modo SIMULADO em Configurações → WhatsApp.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v21.0"

# --- Imagens (Supabase Storage) -------------------------------------------------
# Sem estas variáveis, as fotos vão para public/uploads (só em desenvolvimento).
SUPABASE_URL=""
# Chave service_role do Supabase (somente servidor)
STORAGE_KEY=""
STORAGE_BUCKET="produtos"

# --- Impressão ---------------------------------------------------------------------
# Token compartilhado com o serviço local de impressão (print-agent/.env)
PRINT_AGENT_TOKEN=""
# Reservado: endereço do serviço local caso se opte por modelo "push" no futuro.
# O modelo atual é "pull" (o agente busca a fila), que funciona atrás do roteador da loja.
PRINT_SERVICE_URL=""

# --- Agendador (lembretes de WhatsApp) -------------------------------------------
# A Vercel envia "Authorization: Bearer CRON_SECRET" para /api/cron/notifications
CRON_SECRET=""

# --- Seed (somente desenvolvimento) ------------------------------------------------
SEED_ADMIN_EMAIL="admin@sadyroupas.com.br"
SEED_ADMIN_PASSWORD=""
